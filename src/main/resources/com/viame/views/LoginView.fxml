<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="660.0" prefWidth="1020.0" styleClass="auth-root"
            xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.viame.controller.AuthController">

    <!-- Left Branding Sidebar -->
    <left>
        <VBox alignment="CENTER_LEFT" prefWidth="420.0" spacing="18.0" styleClass="brand-sidebar">
            <Label styleClass="brand-badge" text="INSTITUT SAINT JEAN • JAVA PROGRAMMING II" />
            <Label styleClass="brand-title" text="ViaMe Urban Mobility" wrapText="true" />
            <Label styleClass="brand-subtitle"
                   text="Enterprise 5-Tier Multi-Role Ride Dispatching, Dynamic Surge Tariffing &amp; ACID Settlement Platform."
                   wrapText="true" />

            <Region VBox.vgrow="ALWAYS" />

            <VBox spacing="8.0">
                <Label style="-fx-text-fill: #E2E8F0; -fx-font-weight: bold;" text="Multi-Role Simulation Suite:" />
                <Label styleClass="brand-subtitle" text="• Passenger Console — Fare quote, booking &amp; digital wallet" />
                <Label styleClass="brand-subtitle" text="• Driver Portal — Proximity radar, pessimistic lock &amp; trip states" />
                <Label styleClass="brand-subtitle" text="• Admin Console — Live fleet, pricing rules &amp; 5 BI reports" />
            </VBox>
        </VBox>
    </left>

    <!-- Center Login Form Card -->
    <center>
        <StackPane>
            <padding>
                <Insets bottom="40.0" left="60.0" right="60.0" top="40.0" />
            </padding>

            <VBox alignment="CENTER_LEFT" maxHeight="540.0" maxWidth="440.0" spacing="16.0" styleClass="auth-card">
                <VBox spacing="4.0">
                    <Label styleClass="heading-xl" text="Sign In to ViaMe" />
                    <Label styleClass="text-muted" text="Enter your credentials to access your role workspace." />
                </VBox>

                <Label fx:id="feedbackLabel" managed="false" maxWidth="1.7976931348623157E308"
                       styleClass="error-label" visible="false" wrapText="true" />

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Email Address" />
                    <TextField fx:id="emailField" promptText="e.g. passenger.alice@viame.cm" />
                </VBox>

                <VBox spacing="6.0">
                    <Label styleClass="field-label" text="Password" />
                    <PasswordField fx:id="passwordField" onAction="#handleLogin" promptText="Enter your password" />
                </VBox>

                <Button fx:id="loginButton" defaultButton="true" maxWidth="1.7976931348623157E308"
                        onAction="#handleLogin" styleClass="btn-primary" text="Sign In" />

                <Separator />

                <!-- Quick-Fill Seed Accounts for Defense Demo -->
                <VBox spacing="8.0">
                    <Label styleClass="text-muted" text="Quick-Fill Seed Demo Accounts (Password: Password123!):" />
                    <HBox spacing="8.0">
                        <Button onAction="#handleFillPassengerDemo" styleClass="btn-chip" text="Passenger (Alice)" />
                        <Button onAction="#handleFillDriverDemo" styleClass="btn-chip" text="Driver (Samuel)" />
                        <Button onAction="#handleFillAdminDemo" styleClass="btn-chip" text="Admin Console" />
                    </HBox>
                </VBox>

                <HBox alignment="CENTER" spacing="6.0">
                    <Label styleClass="text-muted" text="Don't have a ViaMe account?" />
                    <Hyperlink onAction="#handleNavigateToRegister" text="Create an Account" />
                </HBox>
            </VBox>
        </StackPane>
    </center>
</BorderPane>

